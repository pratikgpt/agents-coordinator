# Postgres connection string (local docker: see README)
DATABASE_URL=postgres://postgres:dev@localhost:5433/agents

# OpenRouter (https://openrouter.ai/keys) — server-side only, never exposed to the browser
OPENROUTER_API_KEY=

# Model used by all three agents; each can be overridden individually
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
INTAKE_MODEL=
PLANNING_MODEL=
REVIEW_MODEL=

# Max Planning <-> Review correction rounds before surfacing unresolved issues
MAX_REVIEW_ROUNDS=3
